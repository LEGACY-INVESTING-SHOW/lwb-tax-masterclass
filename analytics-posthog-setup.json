{
  "status": "Use the existing shared PostHog project; keep this funnel separate with the funnel event property.",
  "project_name": "Default project",
  "project_id": 600066,
  "project_usage": "Shared by October Challenge and Legacy Wealth Blueprint Webinar; no additional project or billing setup required.",
  "funnel": "legacy_wealth_blueprint_webinar",
  "dashboard": {
    "name": "Legacy Wealth Blueprint Webinar",
    "description": "Live page and campaign traffic, registration actions, failures and engagement. Excludes is_test=true. Tracking starts at deployment; no historical backfill.",
    "pinned": true
  },
  "insights": [
    {
      "name": "Traffic by page",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "TrendsQuery",
          "dateRange": {
            "date_from": "-7d"
          },
          "interval": "day",
          "properties": [
            {
              "type": "event",
              "key": "funnel",
              "operator": "exact",
              "value": "legacy_wealth_blueprint_webinar"
            },
            {
              "type": "event",
              "key": "is_test",
              "operator": "exact",
              "value": "false"
            }
          ],
          "series": [
            {
              "kind": "EventsNode",
              "event": "$pageview",
              "math": "total"
            }
          ],
          "breakdownFilter": {
            "breakdowns": [
              {
                "property": "canonical_path",
                "type": "event"
              }
            ]
          },
          "trendsFilter": {
            "display": "ActionsLineGraph",
            "showLegend": true
          }
        }
      }
    },
