    },
    {
      "source": "/taxseasonisnow/",
      "destination": "/index.html"
    },
    {
      "source": "/future",
      "destination": "/future.html"
    },
    {
      "source": "/future/",
      "destination": "/future.html"
    },
    {
      "source": "/lwbfoundations",
      "destination": "/lwbfoundations.html"
    },
    {
      "source": "/lwbfoundations/",
      "destination": "/lwbfoundations.html"
    },
    {
      "source": "/tax-strategies",
      "destination": "/tax-strategies.html"
    },
    {
      "source": "/tax-strategies/",
      "destination": "/tax-strategies.html"
    },
    {
      "source": "/tax-strategies-v2",
      "destination": "/tax-strategies-v2.html"
    },
    {
      "source": "/tax-strategies-v2/",
      "destination": "/tax-strategies-v2.html"
    },
    {
      "source": "/tax-strategies-yt",
      "destination": "/taxstrategiesyt.html"
    },
    {
      "source": "/tax-strategies-yt/",
